# Banco
DATABASE_URL=postgresql+psycopg://menvi:menvi@localhost:5432/menvi

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# Admin (para endpoints /admin/* e CLI)
ADMIN_API_TOKEN=change-me-admin-token

# Frontends (pros CORS e pros links de email)
MENU_WEB_URL=http://localhost:3000
CRM_WEB_URL=http://localhost:3001

# Email (Resend) — deixa vazio pra usar o provider de log
RESEND_API_KEY=
EMAIL_FROM=Menvi <no-reply@menvi.app>

# Pagamento (Mercado Pago) — deixa vazio pra usar o provider mock
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# WhatsApp (Meta Cloud API) — fica stub por enquanto
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Web Push (VAPID) — deixa vazio pra desligar push. Gera com:
#   pip install py-vapid && vapid --gen && vapid --applicationServerKey
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@menvi.app
